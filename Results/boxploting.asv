% Create a figure with two subplots
figure('Name', 'AUC Boxplots for CN_vs_AD matrix------', 'NumberTitle', 'off');

boxplot(data_AD, group_AD);
title('AUC for CN vs. AD');
xlabel('Method');
ylabel('AUC');
ylim([0 1.1]);
grid on;
xtickangle(45); % Rotate x-axis labels for readability
% Adjust figure size for better visibility
