    auc_CN_vs_CNpos{i} = cell2mat(data.results.CN_vs_CN_pos.av_mae_list);
end

function plot_column_wise_boxplots(data_cell, methods, comparison_name, output_dir)
    if ~exist(output_dir, 'dir')
        mkdir(output_dir);
    end
    num_targets = size(data_cell{1}, 2);
    for t = 1:num_targets
        data_target = cellfun(@(x) x(:,t), data_cell, 'UniformOutput', false);
        data_matrix = [data_target{:}];
        figure;
        boxplot(data_matrix, 'Labels', methods);
        title(['MAE for ' comparison_name ' - Target ' num2str(t)]);
        xlabel('Method');
        ylabel('MAE');
        grid on;
        xtickangle(45);
        filename = fullfile(output_dir, ['MAE_Boxplot_' comparison_name '_Target' num2str(t) '.jpeg']);
        saveas(gcf, filename, 'jpeg');
        close(gcf);
    end
end

% Define output directory
output_dir = 'Results/matrix/withConverters';

% Generate boxplots for each comparison
plot_column_wise_boxplots(auc_CN_vs_AD, methods, 'CN_vs_AD', output_dir);
plot_column_wise_boxplots(auc_CN_vs_MCI, methods, 'CN_vs_MCI', output_dir);
plot_column_wise_boxplots(auc_CN_vs_CNpos, methods, 'CN_vs_CNpos', output_dir);

disp('Boxplots generated and saved successfully.');