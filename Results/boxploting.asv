% Initialize cell arrays to store AUC values
auc_CN_vs_AD = cell(1, length(mat_files));
auc_CN_vs_MCI = cell(1, length(mat_files));
auc_CN_vs_CNpos = cell(1, length(mat_files));
% Load AUC data from each .mat file
for i = 1:length(mat_files)
    disp(mat_files{i})
    data = load(mat_files{i});

        auc_CN_vs_AD{i} = data.results.CN_vs_AD.AUC;
        auc_CN_vs_MCI{i} = data.results.CN_vs_MCI.AUC;
        auc_CN_vs_CNpos{i} = data.results.CN_VS_CNpos.AUC;

end

% Combine AUC values for plotting
% CN_vs_AD data and grouping
