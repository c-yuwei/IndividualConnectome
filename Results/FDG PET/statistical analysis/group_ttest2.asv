clc;

% Add paths to necessary toolboxes (adjust as needed)
addpath(genpath('/home/hang/GitHub/IndividualConnectome-WithYuwei/braph2individualconnectome'));
addpath(genpath('/home/hang/GitHub/Individual-connectome/group_data/ADNI_DATA'));

% Define the groups and their names for comparison
group_names = {'CN', 'MCI', 'AD', 'CN_pos'};
groups = {SUVR_gr1, SUVR_gr2, SUVR_gr3, SUVR_gr4};

% Define the pairs for comparison (e.g., CN vs. AD, CN vs. MCI, etc.)
pairs = {
    {'CN', 'AD'}, ...
    {'CN', 'MCI'}, ...
    {'CN', 'CN_pos'}, ...
    {'MCI', 'AD'}, ...
    {'MCI', 'CN_pos'}, ...
    {'CN_pos', 'AD'}, ...
    {'CN_pos', 'MCI'}
};

% VOI covariates to extract (e.g., 'Age', 'Sex', 'Education')
voi_covariates = {'Age', 'Sex', 'Education'};

% Extract SUVR ST data and VOI covariates for all groups
data = cell(length(groups), 1);
voi = cell(length(groups), 1);
for g = 1:length(groups)
    sub_list = groups{g}.get('SUB_DICT').get('IT_LIST');
    num_subs = length(sub_list);
    % Determine the number of features based on the first subject's ST data
    if num_subs > 0
        first_sub = sub_list{1};
        st_sample = first_sub.get('ST');
        num_features = length(st_sample); % Adjust if ST is a matrix or vector
    else
        num_features = 0; % Handle empty case
    end
    % Extract SUVR ST data
    connectome_data = zeros(num_subs, num_features); % Adjust size as needed
    for s = 1:num_subs
        sub = sub_list{s};
        st_vector = sub.get('ST'); % SUVR ST data
        connectome_data(s, :) = st_vector(:)'; % Flatten to row vector
    end
    data{g} = connectome_data;
    
    % Extract VOI covariates
    voi_data = zeros(num_subs, length(voi_covariates));
    for s = 1:num_subs
        sub = sub_list{s};
        voi_dict = sub.get('VOI_DICT');
        for v = 1:length(voi_covariates)
            voi_value = voi_dict.get('IT', voi_covariates{v}).get('V');
            if iscategorical(voi_value) || ischar(voi_value) % Handle categorical VOI like 'Sex'
                if strcmp(voi_covariates{v}, 'Sex')
                    if strcmp(voi_value, 'Male')
                        voi_value = 0;
                    elseif strcmp(voi_value, 'Female')
                        voi_value = 1;
                    else
                        voi_value = NaN; % Handle unknown values
                    end
                end
            end
            voi_data(s, v) = voi_value;
        end
    end
    voi{g} = voi_data;
end

% Get atlas information for brain region mapping
first_sub = SUVR_gr1.get('SUB_DICT').get('IT', 1); % First subject from CN group
ba = first_sub.get('BA'); % Brain Atlas
br_dict = ba.get('BR_DICT'); % Brain Region Dictionary
region_ids = zeros(1, num_features); % Initialize for 94 regions
region_labels = cell(1, num_features);
for i = 1:num_features
    br = br_dict.get('IT', i); % Get brain region by ID
    region_labels{i} = br.get('LABEL'); % Use label as string
end

% Run tt2 for each pair
pvals_table = table('Size', [length(pairs), 4], 'VariableTypes', {'string', 'double', 'double', 'double'}, ...
    'VariableNames', {'Pair', 'pval_mean', 'tval_mean', 'num_significant'});
significant_regions = cell(length(pairs), 1);

for p = 1:length(pairs)
    group1_name = pairs{p}{1};
    group2_name = pairs{p}{2};
    idx1 = find(strcmp(group_names, group1_name));
    idx2 = find(strcmp(group_names, group2_name));
    
    X1 = data{idx1};
    X2 = data{idx2};
    cov1 = voi{idx1};
    cov2 = voi{idx2};
    cov = [cov1; cov2]; % Combined covariates
    
    % Run tt2
    [pvals, tvals] = tt2(X1, X2, cov);
    pvals_fdr = mafdr(pvals, 'BHFDR', true);
    p_idx = find(pvals_fdr < 0.05);
    
    % Store all p-values with their indices for ranking
    significant_pvals = zeros(length(p_idx), 2); % [index, p-value]
    for i = 1:length(p_idx)
        idx = p_idx(i);
        significant_pvals(i, 1) = idx; % Original index
        significant_pvals(i, 2) = pvals_fdr(idx); % FDR-corrected p-value
    end
    
    % Sort by p-value (lowest to highest for ranking by importance)
    [~, sort_idx] = sort(significant_pvals(:, 2));
    ranked_pvals = significant_pvals(sort_idx, :);
    
    % Store results
    pvals_table.Pair{p} = [group1_name ' vs ' group2_name];
    pvals_table.pval_mean(p) = mean(pvals_fdr); % Mean FDR-corrected p-value
    pvals_table.tval_mean(p) = mean(tvals); % Mean t-value
    pvals_table.num_significant(p) = length(p_idx); % Number of significant features
    
    % Map ranked significant indices to brain regions
    if ~isempty(p_idx)
        significant_regions{p} = table('Size', [length(p_idx), 2], ...
            'VariableTypes', {'string', 'double'}, ...
            'VariableNames', {'Region_Label', 'FDR_pval'});
        for i = 1:length(p_idx)
            idx = ranked_pvals(i, 1); % Use ranked index
            if idx <= num_features
                significant_regions{p}.Region_Label(i) = region_labels{idx};
                significant_regions{p}.FDR_pval(i) = ranked_pvals(i, 2); % Ranked p-value
            else
                warning('Index %d exceeds number of features (%d)', idx, num_features);
            end
        end
    else
        significant_regions{p} = table('Size', [0, 2], ...
            'VariableTypes', {'string', 'double'}, ...
            'VariableNames', {'Region_Label', 'FDR_pval'});
    end
end

% Display the results table
disp('T-test Results Between Groups with FDR Correction:');
disp(pvals_table);

% Display ranked significant regions for each pair
for p = 1:length(pairs)
    if ~isempty(significant_regions{p})
        disp(['Ranked Significant Regions for ' pvals_table.Pair{p} ':']);
        disp(significant_regions{p});
    end
end

% Save results to a file
% save('/home/hang/GitHub/IndividualConnectome-WithYuwei/statistical analysis/ranked_significant_regions_results.mat', 'pvals_table', 'significant_regions');

%%
clc;

% Add paths to necessary toolboxes (adjust as needed)
addpath(genpath('/home/hang/GitHub/IndividualConnectome-WithYuwei/braph2individualconnectome'));
addpath(genpath('/home/hang/GitHub/Individual-connectome/group_data/ADNI_DATA'));
addpath(genpath('/home/hang/GitHub/BRAPH-2/braph2genesis/src')); % Add BRAPH-2 genesis path

% Define the groups and their names for comparison
group_names = {'CN', 'MCI', 'AD', 'CN_pos'};
groups = {SUVR_gr1, SUVR_gr2, SUVR_gr3, SUVR_gr4};

% Define the pairs for comparison (e.g., CN vs. AD, CN vs. MCI, etc.)
pairs = {
    {'CN', 'AD'}, ...
    {'CN', 'MCI'}, ...
    {'CN', 'CN_pos'}, ...
    {'MCI', 'AD'}, ...
    {'CN_pos', 'AD'}, ...
    {'CN_pos', 'MCI'}
};

% VOI covariates to extract (e.g., 'Age', 'Sex', 'Education')
voi_covariates = {'Age', 'Sex', 'Education'};

% Extract SUVR ST data and VOI covariates for all groups
data = cell(length(groups), 1);
voi = cell(length(groups), 1);
for g = 1:length(groups)
    sub_list = groups{g}.get('SUB_DICT').get('IT_LIST');
    num_subs = length(sub_list);
    % Determine the number of features based on the first subject's ST data
    if num_subs > 0
        first_sub = sub_list{1};
        st_sample = first_sub.get('ST');
        num_features = length(st_sample); % Adjust if ST is a matrix or vector
    else
        num_features = 0; % Handle empty case
    end
    % Extract SUVR ST data
    connectome_data = zeros(num_subs, num_features); % Adjust size as needed
    for s = 1:num_subs
        sub = sub_list{s};
        st_vector = sub.get('ST'); % SUVR ST data
        connectome_data(s, :) = st_vector(:)'; % Flatten to row vector
    end
    data{g} = connectome_data;
    
    % Extract VOI covariates
    voi_data = zeros(num_subs, length(voi_covariates));
    for s = 1:num_subs
        sub = sub_list{s};
        voi_dict = sub.get('VOI_DICT');
        for v = 1:length(voi_covariates)
            voi_value = voi_dict.get('IT', voi_covariates{v}).get('V');
            if iscategorical(voi_value) || ischar(voi_value) % Handle categorical VOI like 'Sex'
                if strcmp(voi_covariates{v}, 'Sex')
                    if strcmp(voi_value, 'Male')
                        voi_value = 0;
                    elseif strcmp(voi_value, 'Female')
                        voi_value = 1;
                    else
                        voi_value = NaN; % Handle unknown values
                    end
                end
            end
            voi_data(s, v) = voi_value;
        end
    end
    voi{g} = voi_data;
end

% Get atlas information for brain region mapping
first_sub = SUVR_gr1.get('SUB_DICT').get('IT', 1); % First subject from CN group
ba = first_sub.get('BA'); % Brain Atlas
br_dict = ba.get('BR_DICT'); % Brain Region Dictionary
num_features = numel(br_dict.get('IT_LIST')); % Number of regions
region_ids = cell(1, num_features); % Initialize for region IDs
region_labels = cell(1, num_features);
coordinates = zeros(num_features, 3); % Initialize for 3D coordinates
for i = 1:num_features
    br = br_dict.get('IT', i); % Get brain region by ID
    region_ids{i} = br.get('ID'); % Use string ID
    region_labels{i} = br.get('LABEL'); % Use label as string
    coordinates(i, 1) = br.get('X'); % X coordinate
    coordinates(i, 2) = br.get('Y'); % Y coordinate
    coordinates(i, 3) = br.get('Z'); % Z coordinate
end

% Create BrainAtlasPF with surface
surface_file = 'human_ICBM152.nv'; % Adjust path as needed


% Run tt2 and visualize for each pair
pvals_table = table('Size', [length(pairs), 4], 'VariableTypes', {'string', 'double', 'double', 'double'}, ...
    'VariableNames', {'Pair', 'pval_mean', 'tval_mean', 'num_significant'});
significant_regions = cell(length(pairs), 1);

for p = 1:length(pairs)

    group1_name = pairs{p}{1};
    group2_name = pairs{p}{2};
    idx1 = find(strcmp(group_names, group1_name));
    idx2 = find(strcmp(group_names, group2_name));
    
    X1 = data{idx1};
    X2 = data{idx2};
    cov1 = voi{idx1};
    cov2 = voi{idx2};
    cov = [cov1; cov2]; % Combined covariates
    
    % Run tt2 for this pair
    [pvals, tvals] = tt2(X1, X2, cov);
    pvals_fdr = mafdr(pvals, 'BHFDR', true);
    p_idx = find(pvals_fdr < 0.05);
    
    % Store all p-values with their indices for ranking
    significant_pvals = zeros(length(p_idx), 2); % [index, p-value]
    for i = 1:length(p_idx)
        idx = p_idx(i);
        significant_pvals(i, 1) = idx; % Original index
        significant_pvals(i, 2) = pvals_fdr(idx); % FDR-corrected p-value
    end
    
    % Sort by p-value (lowest to highest for ranking by importance)
    [~, sort_idx] = sort(significant_pvals(:, 2));
    ranked_pvals = significant_pvals(sort_idx, :);
    
    % Store results
    pvals_table.Pair{p} = [group1_name ' vs ' group2_name];
    pvals_table.pval_mean(p) = mean(pvals_fdr); % Mean FDR-corrected p-value
    pvals_table.tval_mean(p) = mean(tvals); % Mean t-value
    pvals_table.num_significant(p) = length(p_idx); % Number of significant features
    
    % Map ranked significant indices to brain regions
    if ~isempty(p_idx)
        significant_regions{p} = table('Size', [length(p_idx), 3], ...
            'VariableTypes', {'string', 'string', 'double'}, ...
            'VariableNames', {'Region_ID', 'Region_Label', 'FDR_pval'});
        for i = 1:length(p_idx)
            idx = ranked_pvals(i, 1); % Use ranked index
            if idx <= num_features
                significant_regions{p}.Region_ID(i) = region_ids{idx};
                significant_regions{p}.Region_Label(i) = region_labels{idx};
                significant_regions{p}.FDR_pval(i) = ranked_pvals(i, 2); % Ranked p-value
            else
                warning('Index %d exceeds number of features (%d)', idx, num_features);
            end
        end
    else
        significant_regions{p} = table('Size', [0, 3], ...
            'VariableTypes', {'string', 'string', 'double'}, ...
            'VariableNames', {'Region_ID', 'Region_Label', 'FDR_pval'});
    end
    
    % Create pair-specific BrainAtlas with only significant regions
    pair_br_dict = IndexedDictionary('ID', ['BR_DICT_' group1_name '_' group2_name], 'IT_CLASS', 'BrainRegion');
    for i = 1:height(significant_regions{p})
        idx = find(strcmp(region_ids, significant_regions{p}.Region_ID(i))); % Find index by ID
        if ~isempty(idx)
            br = br_dict.get('IT', idx);
            pair_br_dict.get('ADD', br);
        end
    end
    ba_pair = BrainAtlas('ID', ['BA_' group1_name '_' group2_name], 'LABEL', [group1_name ' vs ' group2_name], 'NOTES', 'Pair-specific atlas', 'BR_DICT', pair_br_dict);
    pf = BrainAtlasPF(...
        'SURF', ImporterBrainSurfaceNV('FILE', surface_file).get('SURF'), ...
        'BA', ba_pair ...
        );
    % Create pair-specific sph_dict with only significant regions
   pair_sph_dict = IndexedDictionary('ID', ['SPH_DICT_' group1_name '_' group2_name], 'IT_CLASS', 'SettingsSphere');
    for i = 1:height(significant_regions{p})
        idx = find(strcmp(region_ids, significant_regions{p}.Region_ID(i))); % Find index by ID
        if ~isempty(idx)
            br = br_dict.get('IT', char(significant_regions{p}.Region_ID(i)));
            significance = -log10(significant_regions{p}.FDR_pval(i))/5 + 2.5;
            disp(significance);
            % Interpolate FACECOLOR based on significance
            base_color = [0 0 1]; % Blue for low significance
            max_color = [1 0 0]; % Red for high significance
            max_significance = 9; % Cap at -log10(0.00001)/10 + 1 ≈ 1.5
            norm_significance = min(significance / max_significance, 1); % Normalize to [0, 1]
            face_color = base_color + (max_color - base_color) * norm_significance; % Linear interpolation
            sph = SettingsSphere(...
                'PANEL', pf, ...
                'PROP', BrainAtlasPF.H_SPHS, ...
                'I', i, ...
                'VISIBLE', true, ...
                'ID', br.get('ID'), ...
                'X', br.get('X'), ...
                'Y', br.get('Y'), ...
                'Z', br.get('Z'), ...
                'SPHERESIZE', significance, ...
                'FACECOLOR', face_color, ...
                'FACEALPHA', 1 ...
                );
            pair_sph_dict.get('ADD', sph);
        end
    end
    
    % Update BrainAtlasPF with pair-specific BA and sph_dict
    % pf.set('BA', ba_pair);
    pf.set('SPH_DICT', pair_sph_dict);
    % pf.get('DRAW')
    % pf.get('SHOW')
    gui0 = GUIFig('PF', pf, 'FILE', char(fprintf('%d', p)), 'POSITION', [.1 .1 .4 .8], 'WAITBAR', true, 'CLOSEREQ', false);
    gui0.get('DRAW');
    gui0.get('SHOW');
    gui0.get('FILE')
    % f = gcf;
    % saveas(f, ['/home/hang/GitHub/IndividualConnectome-WithYuwei/statistical analysis/' group1_name '_vs_' group2_name '_brain_projection.png']);
    % close(f);

end

% Save results to a file
