%% Camcan
clc;

% Add paths to necessary toolboxes (adjust as needed)
addpath(genpath('/home/hang/GitHub/IndividualConnectome-WithYuwei/braph2individualconnectome'));
addpath(genpath('/home/hang/GitHub/Individual-connectome/group_data/ADNI_DATA'));
addpath(genpath('/home/hang/GitHub/BRAPH-2/braph2genesis/src')); % Add BRAPH-2 genesis path

% Define the groups and their names for comparison
group_names = {'ref', '30', '40', '50'};
groups = {gr_ref, gr_30, gr_40, gr_50}; % For VOI data

% Define the pairs for comparison
pairs = {
    {'30', '40'}, ...
    {'30', '50'}, ...
    {'40', '50'}, ...
};

% VOI covariates to extract (e.g., 'Age', 'Sex', 'Education')
voi_covariates = {'tiv', 'GenderCode'};

% Extract SUVR ST data and VOI covariates for all groups
data = cell(length(groups), 1);
voi = cell(length(groups), 1);
for g = 1:length(groups)
    sub_list = groups{g}.get('SUB_DICT').get('IT_LIST');
    num_subs = length(sub_list);

    % Determine the number of features based on the first subject's ST data
    if num_subs > 0
        first_sub = sub_list{1};
        st_sample = first_sub.get('ST');
        num_features = length(st_sample); % Adjust if ST is a matrix or vector
    else
        num_features = 0; % Handle empty case
    end

    % Extract SUVR ST data
    connectome_data = zeros(num_subs, num_features); % Adjust size as needed
    for s = 1:num_subs
        sub = sub_list{s};
        st_vector = sub.get('ST'); % SUVR ST data
        connectome_data(s, :) = st_vector(:)'; % Flatten to row vector
    end
    data{g} = connectome_data;

    % Extract VOI covariates
    voi_data = zeros(num_subs, length(voi_covariates));
    for s = 1:num_subs
        sub = sub_list{s};
        voi_dict = sub.get('VOI_DICT');
        for v = 1:length(voi_covariates)
            voi_value = voi_dict.get('IT', voi_covariates{v}).get('V');
            if iscategorical(voi_value) || ischar(voi_value) % Handle categorical VOI like 'Sex'
                if strcmp(voi_covariates{v}, 'GenderCode')
                    if strcmp(voi_value, 'Male')
                        voi_value = 0;
                    elseif strcmp(voi_value, 'Female')
                        voi_value = 1;
                    else
                        voi_value = NaN; % Handle unknown values
                    end
                end
            end
            voi_data(s, v) = voi_value;
        end
    end
    voi{g} = voi_data;
end

im_ba = ImporterBrainAtlasXLS( ...
    'FILE', [fileparts(which('atlases')) filesep 'bna_atlas.xlsx'], ...
    'WAITBAR', true ...
    );

ba = im_ba.get('BA');
br_dict = ba.get('BR_DICT'); % Brain Region Dictionary
num_features = numel(br_dict.get('IT_LIST')); % Number of regions

region_ids = cell(1, num_features); % Initialize for region IDs
region_labels = cell(1, num_features);
coordinates = zeros(num_features, 3); % Initialize for 3D coordinates
for i = 1:num_features
    br = br_dict.get('IT', i); % Get brain region by ID
    region_ids{i} = br.get('ID'); % Use string ID
    region_labels{i} = br.get('LABEL'); % Use label as string
    coordinates(i, 1) = br.get('X'); % X coordinate
    coordinates(i, 2) = br.get('Y'); % Y coordinate
    coordinates(i, 3) = br.get('Z'); % Z coordinate
end

% Create BrainAtlasPF with surface
surface_file = 'human_ICBM152.nv'; % Adjust path as needed

% Run tt2 and visualize for each pair, separated by sex
pvals_table = table('Size', [length(pairs) * 2, 5], 'VariableTypes', {'string', 'string', 'double', 'double', 'double'}, ...
    'VariableNames', {'Pair', 'Sex', 'pval_mean', 'tval_mean', 'num_significant'});
significant_regions = cell(length(pairs) * 2, 1);

pair_idx = 1;
for p = 1:length(pairs)
    group1_name = pairs{p}{1};
    group2_name = pairs{p}{2};
    idx1 = find(strcmp(group_names, group1_name));
    idx2 = find(strcmp(group_names, group2_name));

    X1 = data{idx1};
    X2 = data{idx2};
    cov1 = voi{idx1}(:, 1); % Use only tiv (first column), exclude Sex
    cov2 = voi{idx2}(:, 1); % Use only tiv (first column), exclude Sex
    cov = [cov1; cov2]; % Combined covariates (tiv only)

    % Separate by sex using the second column (Sex)
    sex_idx_male = voi{idx1}(:, 2) == 1 | voi{idx2}(size(X1, 1)+1:end, 2) == 1; % Sex = 1 for Male
    sex_idx_female = voi{idx1}(:, 2) == 2 | voi{idx2}(size(X1, 1)+1:end, 2) == 2; % Sex = 2 for Female

    % Male subgroup
    X1_male = X1(voi{idx1}(:, 2) == 1, :);
    X2_male = X2(voi{idx1}(:, 2) == 2, :);
    cov1_male = cov1
    cov_male = cov(sex_idx_male);

    % Female subgroup
    X1_female = X1(sex_idx_female(1:size(X1, 1)), :);
    X2_female = X2(sex_idx_female(size(X1, 1)+1:end), :);
    cov_female = cov(sex_idx_female);

    % Run tt2 for males (without Sex as covariate)
    if ~isempty(X1_male) && ~isempty(X2_male)
        [pvals_male, tvals_male] = tt2(X1_male, X2_male, cov_male);
        pvals_fdr_male = mafdr(pvals_male, 'BHFDR', true);
        p_idx_male = find(pvals_fdr_male < 0.05);
        
        significant_pvals_male = zeros(length(p_idx_male), 2); % [index, p-value]
        for i = 1:length(p_idx_male)
            idx = p_idx_male(i);
            significant_pvals_male(i, 1) = idx; % Original index
            significant_pvals_male(i, 2) = pvals_fdr_male(idx); % FDR-corrected p-value
        end
        [~, sort_idx_male] = sort(significant_pvals_male(:, 2));
        ranked_pvals_male = significant_pvals_male(sort_idx_male, :);

        pvals_table.Pair{pair_idx} = [group1_name ' vs ' group2_name];
        pvals_table.Sex{pair_idx} = 'Male';
        pvals_table.pval_mean(pair_idx) = mean(pvals_fdr_male);
        pvals_table.tval_mean(pair_idx) = mean(tvals_male);
        pvals_table.num_significant(pair_idx) = length(p_idx_male);

        if ~isempty(p_idx_male)
            significant_regions{pair_idx} = table('Size', [length(p_idx_male), 3], ...
                'VariableTypes', {'string', 'string', 'double'}, ...
                'VariableNames', {'Region_ID', 'Region_Label', 'FDR_pval'});
            for i = 1:length(p_idx_male)
                idx = ranked_pvals_male(i, 1);
                if idx <= num_features
                    significant_regions{pair_idx}.Region_ID(i) = region_ids{idx};
                    significant_regions{pair_idx}.Region_Label(i) = region_labels{idx};
                    significant_regions{pair_idx}.FDR_pval(i) = ranked_pvals_male(i, 2);
                else
                    warning('Index %d exceeds number of features (%d)', idx, num_features);
                end
            end
        else
            significant_regions{pair_idx} = table('Size', [0, 3], ...
                'VariableTypes', {'string', 'string', 'double'}, ...
                'VariableNames', {'Region_ID', 'Region_Label', 'FDR_pval'});
        end
        pair_idx = pair_idx + 1;
    else
        warning('Insufficient male data for pair %s vs %s', group1_name, group2_name);
    end

    % Run tt2 for females (without Sex as covariate)
    if ~isempty(X1_female) && ~isempty(X2_female)
        [pvals_female, tvals_female] = tt2(X1_female, X2_female, cov_female);
        pvals_fdr_female = mafdr(pvals_female, 'BHFDR', true);
        p_idx_female = find(pvals_fdr_female < 0.05);
        
        significant_pvals_female = zeros(length(p_idx_female), 2); % [index, p-value]
        for i = 1:length(p_idx_female)
            idx = p_idx_female(i);
            significant_pvals_female(i, 1) = idx; % Original index
            significant_pvals_female(i, 2) = pvals_fdr_female(idx); % FDR-corrected p-value
        end
        [~, sort_idx_female] = sort(significant_pvals_female(:, 2));
        ranked_pvals_female = significant_pvals_female(sort_idx_female, :);

        pvals_table.Pair{pair_idx} = [group1_name ' vs ' group2_name];
        pvals_table.Sex{pair_idx} = 'Female';
        pvals_table.pval_mean(pair_idx) = mean(pvals_fdr_female);
        pvals_table.tval_mean(pair_idx) = mean(tvals_female);
        pvals_table.num_significant(pair_idx) = length(p_idx_female);

        if ~isempty(p_idx_female)
            significant_regions{pair_idx} = table('Size', [length(p_idx_female), 3], ...
                'VariableTypes', {'string', 'string', 'double'}, ...
                'VariableNames', {'Region_ID', 'Region_Label', 'FDR_pval'});
            for i = 1:length(p_idx_female)
                idx = ranked_pvals_female(i, 1);
                if idx <= num_features
                    significant_regions{pair_idx}.Region_ID(i) = region_ids{idx};
                    significant_regions{pair_idx}.Region_Label(i) = region_labels{idx};
                    significant_regions{pair_idx}.FDR_pval(i) = ranked_pvals_female(i, 2);
                else
                    warning('Index %d exceeds number of features (%d)', idx, num_features);
                end
            end
        else
            significant_regions{pair_idx} = table('Size', [0, 3], ...
                'VariableTypes', {'string', 'string', 'double'}, ...
                'VariableNames', {'Region_ID', 'Region_Label', 'FDR_pval'});
        end
        pair_idx = pair_idx + 1;
    else
        warning('Insufficient female data for pair %s vs %s', group1_name, group2_name);
    end

    % Visualization for males
    if ~isempty(X1_male) && ~isempty(X2_male)
        pair_br_dict_male = IndexedDictionary('ID', ['BR_DICT_' group1_name '_' group2_name '_Male'], 'IT_CLASS', 'BrainRegion');
        for i = 1:height(significant_regions{pair_idx-2})
            idx = find(strcmp(region_ids, significant_regions{pair_idx-2}.Region_ID(i)));
            if ~isempty(idx)
                br = br_dict.get('IT', idx);
                pair_br_dict_male.get('ADD', br);
            end
        end
        ba_pair_male = BrainAtlas('ID', ['BA_' group1_name '_' group2_name '_Male'], 'LABEL', [group1_name ' vs ' group2_name ' (Male)'], 'NOTES', 'Male-specific atlas', 'BR_DICT', pair_br_dict_male);
        pf_male = BrainAtlasPF('SURF', ImporterBrainSurfaceNV('FILE', surface_file).get('SURF'), 'BA', ba_pair_male);
        pair_sph_dict_male = IndexedDictionary('ID', ['SPH_DICT_' group1_name '_' group2_name '_Male'], 'IT_CLASS', 'SettingsSphere');
        for i = 1:height(significant_regions{pair_idx-2})
            idx = find(strcmp(region_ids, significant_regions{pair_idx-2}.Region_ID(i)));
            if ~isempty(idx)
                br = br_dict.get('IT', char(significant_regions{pair_idx-2}.Region_ID(i)));
                significance = -log10(significant_regions{pair_idx-2}.FDR_pval(i))/6.5 + 2.5;
                base_color = [0 0 1]; % Blue for low significance
                max_color = [1 0 0]; % Red for high significance
                max_significance = 6.5;
                norm_significance = min(significance / max_significance, 1);
                face_color = base_color + (max_color - base_color) * norm_significance;
                sph = SettingsSphere('PANEL', pf_male, 'PROP', BrainAtlasPF.H_SPHS, 'I', i, 'VISIBLE', true, 'ID', br.get('ID'), 'X', br.get('X'), 'Y', br.get('Y'), 'Z', br.get('Z'), 'SPHERESIZE', significance, 'FACECOLOR', face_color, 'FACEALPHA', 1);
                pair_sph_dict_male.get('ADD', sph);
            end
        end
        pf_male.set('SPH_DICT', pair_sph_dict_male);
        gui0_male = GUIFig('PF', pf_male, 'FILE', char(fprintf('%d_male', p)), 'POSITION', [.1 .1 .4 .8], 'WAITBAR', true, 'CLOSEREQ', false);
        gui0_male.get('DRAW');
        gui0_male.get('SHOW');
    end

    % Visualization for females
    if ~isempty(X1_female) && ~isempty(X2_female)
        pair_br_dict_female = IndexedDictionary('ID', ['BR_DICT_' group1_name '_' group2_name '_Female'], 'IT_CLASS', 'BrainRegion');
        for i = 1:height(significant_regions{pair_idx-1})
            idx = find(strcmp(region_ids, significant_regions{pair_idx-1}.Region_ID(i)));
            if ~isempty(idx)
                br = br_dict.get('IT', idx);
                pair_br_dict_female.get('ADD', br);
            end
        end
        ba_pair_female = BrainAtlas('ID', ['BA_' group1_name '_' group2_name '_Female'], 'LABEL', [group1_name ' vs ' group2_name ' (Female)'], 'NOTES', 'Female-specific atlas', 'BR_DICT', pair_br_dict_female);
        pf_female = BrainAtlasPF('SURF', ImporterBrainSurfaceNV('FILE', surface_file).get('SURF'), 'BA', ba_pair_female);
        pair_sph_dict_female = IndexedDictionary('ID', ['SPH_DICT_' group1_name '_' group2_name '_Female'], 'IT_CLASS', 'SettingsSphere');
        for i = 1:height(significant_regions{pair_idx-1})
            idx = find(strcmp(region_ids, significant_regions{pair_idx-1}.Region_ID(i)));
            if ~isempty(idx)
                br = br_dict.get('IT', char(significant_regions{pair_idx-1}.Region_ID(i)));
                significance = -log10(significant_regions{pair_idx-1}.FDR_pval(i))/6.5 + 2.5;
                base_color = [0 0 1]; % Blue for low significance
                max_color = [1 0 0]; % Red for high significance
                max_significance = 6.5;
                norm_significance = min(significance / max_significance, 1);
                face_color = base_color + (max_color - base_color) * norm_significance;
                sph = SettingsSphere('PANEL', pf_female, 'PROP', BrainAtlasPF.H_SPHS, 'I', i, 'VISIBLE', true, 'ID', br.get('ID'), 'X', br.get('X'), 'Y', br.get('Y'), 'Z', br.get('Z'), 'SPHERESIZE', significance, 'FACECOLOR', face_color, 'FACEALPHA', 1);
                pair_sph_dict_female.get('ADD', sph);
            end
        end
        pf_female.set('SPH_DICT', pair_sph_dict_female);
        gui0_female = GUIFig('PF', pf_female, 'FILE', char(fprintf('%d_female', p)), 'POSITION', [.5 .1 .4 .8], 'WAITBAR', true, 'CLOSEREQ', false);
        gui0_female.get('DRAW');
        gui0_female.get('SHOW');
    end
end

% Display summary table
disp('Summary of t-test results by sex:');
disp(pvals_table);
