%% Simulated data for verification

clear; clc;

% Add paths to necessary toolboxes (adjust as needed)
addpath(genpath('/home/hang/GitHub/IndividualConnectome-WithYuwei/braph2individualconnectome'));
addpath(genpath('/home/hang/GitHub/Individual-connectome/group_data/ADNI_DATA'));
addpath(genpath('/home/hang/GitHub/BRAPH-2/braph2genesis/src')); % Add BRAPH-2 genesis path
% Define the pairs for comparison
pairs = {
    {'30', '40'}, ...
    {'30', '50'}, ...
    {'40', '50'}, ...
};
% Simulate BrainAtlas with 5 regions (for simplicity)
num_regions = 15; % Small number for simulation
br_dict = IndexedDictionary('IT_CLASS', 'BrainRegion');
for i = 1:num_regions
    br = BrainRegion('ID', num2str(i), 'LABEL', ['Region ' num2str(i)], 'NOTES', '', 'X', rand, 'Y', rand, 'Z', rand);
    br_dict.get('ADD', br);
end
ba = BrainAtlas('BR_DICT', br_dict);

% Simulate groups with different number of subjects
group_names = {'ref', '30', '40', '50'};
groups = cell(1, 4);
data = cell(4, 1);
voi = cell(4, 1);
num_features = num_regions;
voi_covariates = {'tiv', 'GenderCode'};

% Subject counts: ref (20), 30 (25), 40 (30), 50 (20)
subject_counts = [20, 25, 30, 20];

for g = 1:4
    num_subs = subject_counts(g);
    sub_dict = IndexedDictionary('IT_CLASS', 'SubjectST');
    connectome_data = zeros(num_subs, num_features);
    voi_data = zeros(num_subs, 2); % tiv and GenderCode
    
    for s = 1:num_subs
        % Simulate ST data (connectome row values)
        st_vector = rand(1, num_features) + max((g-3),0) * 0.5; % Slight offset per group
        
        % Simulate VOI
        tiv = rand * 1000 + 1000000; % Random tiv
        gender = randi([1,2]); % 1 or 2
        
        voi_dict = IndexedDictionary('IT_CLASS', 'VOINumeric');
        voi_dict.get('ADD', VOINumeric('ID', 'tiv', 'V', tiv));
        voi_dict.get('ADD', VOINumeric('ID', 'GenderCode', 'V', gender));
        
        sub = SubjectST('ID', num2str(s), 'BA', ba, 'ST', st_vector', 'VOI_DICT', voi_dict);
        sub_dict.get('ADD', sub);
        
        connectome_data(s, :) = st_vector;
        voi_data(s, 1) = tiv;
        voi_data(s, 2) = gender;
    end
    
    groups{g} = Group('SUB_CLASS', 'SubjectST', 'SUB_DICT', sub_dict);
    data{g} = connectome_data;
    voi{g} = voi_data;
end

% Verify VOI extraction
for g = 1:4
    disp([group_names{g} ' VOI data size: ' num2str(size(voi{g}))]);
end

% Extract atlas information for brain region mapping
num_features = numel(br_dict.get('IT_LIST')); % Number of regions
region_ids = cell(1, num_features); % Initialize for region IDs
region_labels = cell(1, num_features);
coordinates = zeros(num_features, 3); % Initialize for 3D coordinates
for i = 1:num_features
    br = br_dict.get('IT', i); % Get brain region by ID
    region_ids{i} = br.get('ID'); % Use string ID
    region_labels{i} = br.get('LABEL'); % Use label as string
    coordinates(i, 1) = br.get('X'); % X coordinate
    coordinates(i, 2) = br.get('Y'); % Y coordinate
    coordinates(i, 3) = br.get('Z'); % Z coordinate
end

num_features = numel(br_dict.get('IT_LIST')); % Number of regions
% Create BrainAtlasPF with surface (simulated, assume surface_file exists)
surface_file = 'human_ICBM152.nv'; % Adjust path as needed

% Run tt2 and visualize for each pair, separated by sex
pvals_table = table('Size', [length(pairs) * 2, 4], 'VariableTypes', {'string',  'double', 'double', 'double'}, ...
    'VariableNames', {'Pair',  'pval_mean', 'tval_mean', 'num_significant'});
significant_regions = cell(length(pairs) * 2, 1);
pair_idx = 1;

for p = 1:length(pairs)
    group1_name = pairs{p}{1};
    group2_name = pairs{p}{2};
    idx1 = find(strcmp(group_names, group1_name));
    idx2 = find(strcmp(group_names, group2_name));
    X1 = data{idx1};
    X2 = data{idx2};
    cov1 = voi{idx1}(:, 1); % Use only tiv (first column), exclude Sex
    cov2 = voi{idx2}(:, 1); % Use only tiv (first column), exclude Sex
    cov = [cov1; cov2]; % Combined covariates (tiv only)
    [pvals, tvals] = tt2(X1, X2, cov);
    pvals_fdr = mafdr(pvals, 'BHFDR', true);
    p_idx = find(pvals_fdr < 0.05);
    significant_pvals = zeros(length(p_idx), 2); % [index, p-value]
    for i = 1:length(p_idx)
        idx = p_idx(i);
        significant_pvals(i, 1) = idx; % Original index
        significant_pvals(i, 2) = pvals_fdr(idx); % FDR-corrected p-value
    end
    [~, sort_idx] = sort(significant_pvals(:, 2));
    ranked_pvals = significant_pvals(sort_idx, :);
    pvals_table.Pair{pair_idx} = [group1_name ' vs ' group2_name];
    pvals_table.pval_mean(pair_idx) = mean(pvals_fdr);
    pvals_table.tval_mean(pair_idx) = mean(tvals);
    pvals_table.num_significant(pair_idx) = length(p_idx);
    if ~isempty(p_idx)
        significant_regions{pair_idx} = table('Size', [length(p_idx), 5 ], ...
            'VariableTypes', {'string', 'string', 'string', 'double', 'double'}, ...
            'VariableNames', {'Region_ID', 'Region_Label', 'Raw_Region_Label', 'FDR_pval', 'Raw_FDR_pval'});
        for i = 1:length(p_idx)
            idx = ranked_pvals(i, 1);
            if idx <= num_features
                significant_regions{pair_idx}.Region_ID(i) = region_ids{idx};
                significant_regions{pair_idx}.Region_Label(i) = region_labels{idx};
                significant_regions{pair_idx}.FDR_pval(i) = ranked_pvals(i, 2);
            else
                warning('Index %d exceeds number of features (%d)', idx, num_features);
            end
        end

    end
    pair_idx = pair_idx +1;

end

% Display summary table
disp('Summary of t-test results by sex:');
disp(pvals_table);
%% region wise difference by age groups for each gender
clc;

% Add paths to necessary toolboxes (adjust as needed)
addpath(genpath('/home/hang/GitHub/IndividualConnectome-WithYuwei/braph2individualconnectome'));
addpath(genpath('/home/hang/GitHub/Individual-connectome/group_data/ADNI_DATA'));
addpath(genpath('/home/hang/GitHub/BRAPH-2/braph2genesis/src')); % Add BRAPH-2 genesis path

% Define the groups and their names for comparison
group_names = {'30', '40', '50'};
groups = {gr_30, gr_40, gr_50}; % For VOI data

% Define the pairs for comparison (not used in this analysis but kept for context)
pairs = {
    {'30', '40'}, ...
    {'30', '50'}, ...
    {'40', '50'}, ...
};

im_ba = ImporterBrainAtlasXLS( ...
    'FILE', [fileparts(which('atlases')) filesep 'bna_atlas.xlsx'], ...
    'WAITBAR', true ...
    );

ba = im_ba.get('BA');
br_dict = ba.get('BR_DICT'); % Brain Region Dictionary
num_features = numel(br_dict.get('IT_LIST')); % Number of regions

region_ids = cell(1, num_features); % Initialize for region IDs
region_labels = cell(1, num_features);
coordinates = zeros(num_features, 3); % Initialize for 3D coordinates
for i = 1:num_features
    br = br_dict.get('IT', i); % Get brain region by ID
    region_ids{i} = br.get('ID'); % Use string ID
    region_labels{i} = br.get('LABEL'); % Use label as string
    coordinates(i, 1) = br.get('X'); % X coordinate
    coordinates(i, 2) = br.get('Y'); % Y coordinate
    coordinates(i, 3) = br.get('Z'); % Z coordinate
end

% VOI covariates to extract (e.g., 'Age', 'Sex', 'Education')
voi_covariates = {'tiv', 'GenderCode'};

% Extract SUVR ST data and VOI covariates for all groups
data = cell(length(groups), 1);
voi = cell(length(groups), 1);
for g = 1:length(groups)
    sub_list = groups{g}.get('SUB_DICT').get('IT_LIST');
    num_subs = length(sub_list);

    % Determine the number of features based on the first subject's ST data
    if num_subs > 0
        first_sub = sub_list{1};
        st_sample = first_sub.get('ST');
        num_features = length(st_sample); % Number of brain regions
    else
        num_features = 0; % Handle empty case
    end

    % Extract SUVR ST data
    connectome_data = zeros(num_subs, num_features); % Adjust size as needed
    for s = 1:num_subs
        sub = sub_list{s};
        st_vector = sub.get('ST'); % SUVR ST data
        connectome_data(s, :) = st_vector(:)'; % Flatten to row vector
    end
    data{g} = connectome_data;

    % Extract VOI covariates
    voi_data = zeros(num_subs, length(voi_covariates));
    for s = 1:num_subs
        sub = sub_list{s};
        voi_dict = sub.get('VOI_DICT');
        for v = 1:length(voi_covariates)
            voi_value = voi_dict.get('IT', voi_covariates{v}).get('V');
            voi_data(s, v) = voi_value;
        end
    end
    voi{g} = voi_data;
end

% Analyze brain region-wise differences by gender and age group
num_groups = length(groups);
subgroup_data = struct(); % Store data by age group and gender
for g = 1:num_groups
    age_group = group_names{g};
    sub_list = groups{g}.get('SUB_DICT').get('IT_LIST');
    st_data = data{g}; % ST data for this age group
    voi_data = voi{g}; % VOI data for this age group
    num_subs = size(st_data, 1);
   
    for s = 1:num_subs
        gender = voi_data(s, 2); % GenderCode: 1 for Male, 2 for Female
        gender_label = ifelse(gender == 1, 'Male', 'Female');
        subgroup_key = [gender_label '_Age_' age_group]; % Updated key format
       
        % Store ST values for this subject with preallocation
        if ~isfield(subgroup_data, subgroup_key)
            subgroup_data.(subgroup_key) = zeros(num_subs, num_features); % Preallocate with correct size
        end
        subgroup_data.(subgroup_key)(s, :) = st_data(s, :);
        
    end
    subgroup_data.(subgroup_key)
end


% Compute mean and std for each brain region by subgroup
subgroup_stats = struct();
for field = fieldnames(subgroup_data)'
    key = field{1};
    data_matrix = subgroup_data.(key);
    valid_data = data_matrix(any(data_matrix, 2), :); % Remove rows with all zeros if any
    if ~isempty(valid_data)
        subgroup_stats.(key).mean = mean(valid_data, 1); % Mean across subjects for each region
        subgroup_stats.(key).std = std(valid_data, 0, 1); % Std across subjects for each region
    else
        subgroup_stats.(key).mean = NaN(1, num_features);
        subgroup_stats.(key).std = NaN(1, num_features);
    end
end
%%
% Select top regions with biggest differences and create boxplots with individual dots
age_groups = {'30', '40', '50'};
top_n = 5; % Number of top regions to select
top_regions = struct(); % Store top regions for each age group

for ag = 1:length(age_groups)
    age_group = age_groups{ag};
    valid_age_group = ['Age_' age_group]; % Use valid field name
    male_key = ['Male_Age_' age_group];
    female_key = ['Female_Age_' age_group];
    
    if isfield(subgroup_stats, male_key) && isfield(subgroup_stats, female_key)
        mean_male = subgroup_stats.(male_key).mean;
        mean_female = subgroup_stats.(female_key).mean;
        difference = abs(mean_female - mean_male); % Absolute difference between male and female means
        
        % Find indices of top N regions with biggest differences
        [~, sort_idx] = sort(difference, 'descend');
        top_idx = sort_idx(1:top_n);
        top_regions.(valid_age_group) = top_idx; % Use valid field name
        
        % Create boxplots with individual dots for top regions
        figure('Name', sprintf('Boxplots with Dots for Top %d Regions in Age %s', top_n, age_group), 'NumberTitle', 'off');
        num_plots = length(top_idx);
        if num_plots > 0
            subplot_cols = min(5, num_plots); % Limit to 5 columns for layout
            subplot_rows = ceil(num_plots / subplot_cols);
            for i = 1:num_plots
                subplot(subplot_rows, subplot_cols, i);
                male_data = subgroup_data.(male_key)(:, top_idx(i));
                female_data = subgroup_data.(female_key)(:, top_idx(i));
                
                % Create boxplot
                boxplot([male_data, female_data], 'Labels', {'Male', 'Female'}, 'Colors', ['b', 'r'], 'Widths', 0.5);
                hold on;
                
                % Overlay individual dots with minimal jitter and transparency
                x_male = ones(size(male_data)) * 1 + randn(size(male_data)) * 0.05; % Jitter around 1
                scatter(x_male, male_data, 10, 'b', 'filled', 'MarkerEdgeColor', 'b', 'MarkerFaceAlpha', 0.5);
                x_female = ones(size(female_data)) * 2 + randn(size(female_data)) * 0.05; % Jitter around 2
                scatter(x_female, female_data, 10, 'r', 'filled', 'MarkerEdgeColor', 'r', 'MarkerFaceAlpha', 0.5);
                hold off;
                
                title(sprintf('Region %d (Diff: %.4f)', top_idx(i), difference(top_idx(i))));
                ylabel('ST Value');
                grid on;
                set(gca, 'XTick', [1 2], 'XTickLabel', {'Male', 'Female'}); % Ensure x-ticks align with labels
            end
            set(gcf, 'Position', [100, 100, 1200, 400]); % Adjust figure size for clarity
        else
            disp(['No significant differences found for Age ' age_group]);
        end
    else
        warning('Missing data for Age %s in male or female', age_group);
    end
end
%%
% Compute mean values for plotting
mean_values_male = struct();
mean_values_female = struct();
age_groups = {'30', '40', '50'}; % Focus on these three age groups
for ag = 1:length(age_groups)
    age_group = age_groups{ag};
    valid_age_group = ['Age_' age_group]; % Match the struct field name
    male_key = ['Male_Age_' age_group];
    female_key = ['Female_Age_' age_group];
    if isfield(subgroup_stats, male_key)
        mean_values_male.(valid_age_group) = subgroup_stats.(male_key).mean;
    else
        mean_values_male.(valid_age_group) = NaN(1, num_features);
    end
    if isfield(subgroup_stats, female_key)
        mean_values_female.(valid_age_group) = subgroup_stats.(female_key).mean;
    else
        mean_values_female.(valid_age_group) = NaN(1, num_features);
    end
end

% Plot mean values by gender for three age groups
% Plot for Males
figure('Name', 'Mean ST Values by Brain Region (Males)', 'NumberTitle', 'off');
hold on;
colors = {'b', 'g', 'm'}; % Different colors for Age_30, Age_40, Age_50
for ag = 1:length(age_groups)
    age_group = age_groups{ag};
    valid_age_group = ['Age_' age_group]; % Match the struct field name
    if isfield(mean_values_male, valid_age_group)
        plot(1:num_features, mean_values_male.(valid_age_group), 'Color', colors{ag}, 'LineWidth', 2, ...
             'DisplayName', ['Age_' age_group]);
    end
end
hold off;
title('Mean ST Values by Brain Region (Males)');
xlabel('Brain Region');
ylabel('Mean ST Value');
% Set x-axis labels to region labels with rotation
set(gca, 'XTick', 1:num_features, 'XTickLabel', region_labels, 'XTickLabelRotation', 45);
legend('show', 'Location', 'Best');
grid on;

% Plot for Females
figure('Name', 'Mean ST Values by Brain Region (Females)', 'NumberTitle', 'off');
hold on;
for ag = 1:length(age_groups)
    age_group = age_groups{ag};
    valid_age_group = ['Age_' age_group]; % Match the struct field name
    if isfield(mean_values_female, valid_age_group)
        plot(1:num_features, mean_values_female.(valid_age_group), 'Color', colors{ag}, 'LineWidth', 2, ...
             'DisplayName', ['Age_' age_group]);
    end
end
hold off;
title('Mean ST Values by Brain Region (Females)');
xlabel('Brain Region');
ylabel('Mean ST Value');
% Set x-axis labels to region labels with rotation
set(gca, 'XTick', 1:num_features, 'XTickLabel', region_labels, 'XTickLabelRotation', 45);
legend('show', 'Location', 'Best');
grid on;

% Optional: Display mean and std differences
disp('Mean and Std Differences by Brain Region, Gender, and Age Group:');
for r = 1:num_features
    fprintf('Region %d:\n', r);
    for field = fieldnames(subgroup_stats)'
        key = field{1};
        fprintf('  %s - Mean: %.4f, Std: %.4f\n', key, subgroup_stats.(key).mean(r), subgroup_stats.(key).std(r));
    end
end


% Compute regional-wise difference by age group pair for each gender
age_pairs = {'30_vs_40', '30_vs_50', '40_vs_50'};
genders = {'Male', 'Female'};

difference_stats = struct();
ranked_differences = struct();

for gnd = 1:length(genders)
    gender = genders{gnd};
    for pr = 1:length(age_pairs)
        pair = age_pairs{pr};
        groups = strsplit(pair, '_vs_');
        age_group1 = groups{1};
        age_group2 = groups{2};
        key1 = [gender '_Age_' age_group1];
        key2 = [gender '_Age_' age_group2];
        
        if isfield(subgroup_stats, key1) && isfield(subgroup_stats, key2)
            mean1 = subgroup_stats.(key1).mean;
            mean2 = subgroup_stats.(key2).mean;
            difference = mean1 - mean2; % Difference: Group1 - Group2
            
            % Store differences
            diff_key = [gender '_' pair];
            difference_stats.(diff_key) = difference;
            
            % Rank regions by difference (descending order)
            [sorted_diff, sort_idx] = sort(difference, 'descend');
            ranked_regions = table(sorted_diff', region_ids(sort_idx)', region_labels(sort_idx)', ...
                'VariableNames', {'Difference', 'Region_ID', 'Region_Label'});
            ranked_differences.(diff_key) = ranked_regions;
            
            % Display ranked differences
            disp([diff_key ' Ranked Differences:']);
            disp(ranked_regions);
        else
            warning('Missing data for %s in %s or %s', diff_key, key1, key2);
        end
    end
end
        
disp('Overlap of Significant Regions with Ranked Differences by Gender and Age Pair:');

% Plot p-values and differences for overlapping regions with correlation
genders = {'male', 'female'}; % Match the struct field names
age_pairs = {'30_vs_40', '30_vs_50', '40_vs_50'};

for gnd = 1:length(genders)
    gender = genders{gnd};
    for pr = 1:length(age_pairs)
        pair = age_pairs{pr};
        valid_pair_key = ['Pair_' strrep(pair, ' ', '_')]; % Consistent prefix for both structs
        
        % Extract data from summary_significant_regions
        if isfield(summary_significant_regions, gender) && isfield(summary_significant_regions.(gender), valid_pair_key)
            sig_regions = summary_significant_regions.(gender).(valid_pair_key);
            p_vals = sig_regions.FDR_pval;
            region_labels_sig = sig_regions.Region_Label;
        else
            continue; % Skip if no significant regions for this pair
        end
        
        % Extract data from ranked_differences (align key with prefix)
        diff_key = [upper(gender(1)) gender(2:end) '_' pair]; % Use the same Pair_ prefix
        if isfield(ranked_differences, diff_key)
            diff_regions = ranked_differences.(diff_key);
            differences = diff_regions.Difference;
            region_labels_diff = diff_regions.Region_Label;
        else
            continue; % Skip if no differences for this pair
        end
        
        % Find overlapping regions
        [overlap_labels, ia, ib] = intersect(region_labels_sig, region_labels_diff, 'stable');
        if ~isempty(overlap_labels)
            p_vals_overlap = p_vals(ia);
            diff_overlap = differences(ib);
            
            % Calculate correlation
            corr_matrix = corrcoef(p_vals_overlap, diff_overlap);
            correlation = corr_matrix(1, 2); % Pearson correlation coefficient
            
            % Create plot
            figure('Name', [gender ' - ' strrep(pair, '_', ' vs ') ' P-values vs Differences'], 'NumberTitle', 'off');
            yyaxis left;
            plot(1:length(overlap_labels), p_vals_overlap, 'b-o', 'LineWidth', 1.5, 'MarkerSize', 6, ...
                 'DisplayName', 'FDR p-value');
            ylabel('FDR p-value');
            ylim([0, max(p_vals_overlap) * 1.1]); % Adjust ylim for p-values
            
            yyaxis right;
            plot(1:length(overlap_labels), diff_overlap, 'r-o', 'LineWidth', 1.5, 'MarkerSize', 6, ...
                 'DisplayName', 'Mean Difference');
            ylabel('Mean Difference');
            ylim([min(diff_overlap) * 1.1, max(diff_overlap) * 1.1]); % Adjust ylim for differences
            
            % Set x-axis labels
            set(gca, 'XTick', 1:length(overlap_labels), 'XTickLabel', overlap_labels, 'XTickLabelRotation', 45);
            xlabel('Region Label');
            title([gender ' - ' strrep(pair, '_', ' vs ') ' Overlapping Significant Regions (Corr: %.3f)', correlation]);
            legend('show', 'Location', 'Best');
            grid on;
            
            % Display correlation
            fprintf('Correlation between p-values and differences for %s - %s: %.3f\n', gender, strrep(pair, '_', ' vs '), correlation);
        else
            warning(['No overlapping regions found for ' gender ' - ' pair]);
        end
    end
end
function out = ifelse(condition, valueIfTrue, valueIfFalse)
    if condition
        out = valueIfTrue;
    else
        out = valueIfFalse;
    end
end


