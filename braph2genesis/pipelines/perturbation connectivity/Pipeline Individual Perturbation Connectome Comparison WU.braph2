%% Pipeline Individual Perturbation Connectome Comparison WU

% This is the pipeline script to analyze a group of subjects using individual Perturbation connectivity built on structural data.
% The structural data can be derived from imaging modalities like T1 weighted MRI (T1-W), static positron emission tomography (PET), or arterial spin labeling (ASL).
% 1. It loads a brain atlas from an XLS file (e.g., desikan_atlas.xlsx).
% 2. It loads the data of a group of subjects from an XLS file (e.g., ST_group1.xlsx).
% 3. It analyzes these data using a structural analysis (ST) based on a binary undirected graph using densities (BUD).

% PDF: /tutorials/pipelines/tut_a_st_wu/tut_a_st_wu.pdf
% README: /tutorials/pipelines/tut_a_st_wu/readme.md

%% Brain Atlas
ba1 = ImporterBrainAtlasXLS('WAITBAR', true).get('GET_FILE').get('BA'); % Load Brain Atlas from XLS % Brain Atlas
ba2 = ImporterBrainAtlasXLS('WAITBAR', true).get('GET_FILE').get('BA'); % Load Brain Atlas from XLS % Brain Atlas

%% Group 1 NIfTI
gr_t1_1 = ImporterGroupSubjNIfTI('NIFTI_TYPE', {'T1'}, 'WAITBAR', true); % Load Group T1 from NIfTI % Group 1 T1
gr_pet_1 = ImporterGroupSubjNIfTI('NIFTI_TYPE', {'PET'}, 'WAITBAR', true); % Load Group PET from NIfTI % Group 1 PET

%% Group NIfTI healthy reference
gr_t1_healthy = ImporterGroupSubjNIfTI('NIFTI_TYPE', {'T1'}, 'WAITBAR', true); % Load Group T1 from NIfTI healthy reference group % Healthy Group T1
gr_pet_healthy = ImporterGroupSubjNIfTI('NIFTI_TYPE', {'PET'}, 'WAITBAR', true); % Load Group PET from NIfTI healthy reference group % Healthy Group PET

%% Group SUVR
suvr_con = SUVRConstructor('GR_PET',gr_pet_1.get('GR'),'GR_T1',gr_t1_1.get('GR'),'BA', {ba1, ba2},'ATLAS_PATH_DICT' ,IndexedDictionary('IT_CLASS', 'FILE_PATH','IT_LIST', {FILE_PATH('PATH', '/home/hang/GitHub/IndividualConnectome-WithYuwei/group_data/test/atlas/upsampled_AAL2.nii'),FILE_PATH('PATH', '/home/hang/GitHub/IndividualConnectome-WithYuwei/group_data/test/atlas/upsampled_TD.nii')}), 'REF_REGION_LIST',{[9100,9110,9120,9130,9140,9150,9160,9170], 7},'ATLAS_KIND', {'AAL2','TD'}, 'ATLAS_INDEX', 1); % Construct Group SUVR % Group SUVR
suvr_con_healthy = SUVRConstructor('GR_PET',gr_pet_healthy.get('GR'),'GR_T1',gr_t1_healthy.get('GR'),'BA', {ba1, ba2},'ATLAS_PATH_DICT' ,IndexedDictionary('IT_CLASS', 'FILE_PATH','IT_LIST', {FILE_PATH('PATH', '/home/hang/GitHub/IndividualConnectome-WithYuwei/group_data/test/atlas/upsampled_AAL2.nii'),FILE_PATH('PATH', '/home/hang/GitHub/IndividualConnectome-WithYuwei/group_data/test/atlas/upsampled_TD.nii')}), 'REF_REGION_LIST',{[9100,9110,9120,9130,9140,9150,9160,9170], 7},'ATLAS_KIND', {'AAL2','TD'}, 'ATLAS_INDEX', 1); % Construct Healthy Group SUVR % Healthy Group SUVR

%% Devitation Connectome Construction
im_gr1 = IndividualPerturbationConConstructor('GR_SUVR', suvr_con.get('GR'),'GR_SUVR_REF', suvr_con_healthy.get('GR'), 'VOI_SELECTION',{'Age'}); % Construct perturbation based individual connectome % Group perturbation Connectivity

%% Construction and Analysis on individual perturbation connectivity group 1
a_WU1 = AnalyzeEnsemble_CON_WU('GR', im_gr1.get('GR')); % Analyze Group % Group 1 Analysis

%% Construction and Analysis on individual perturbation connectivity reference group
a_WU2 = AnalyzeEnsemble_CON_WU('TEMPLATE', a_WU1,'GR', im_gr2.get('GR')); % Analyze Group reference % Group reference Analysis

%% Comparison
c_WU = CompareEnsemble('P', 1000, 'A1', a_WU1, 'A2', a_WU2, 'MEMORIZE', true); % Compare Groups % Group Comparison