%% Pipeline PDFs to Connectivity Correlation

% This is the pipeline script to convert regional probability density functions (PDFs)

% into individual connectivity data using correlation.

% 1. It loads a brain atlas from an XLS file.
% 2. It loads a group of subjects with regional PDFs from XLS files.
% 3. It converts the PDF data into connectivity matrices using correlation.
% 4. It exports the resulting connectivity data and brain atlas.

% PDF: 
% README: 

%% Brain Atlas
ba = ImporterBrainAtlasXLS('WAITBAR', true).get('GET_FILE').get('BA'); % Load Brain Atlas from XLS % Brain Atlas

%% Group PDFs
gr_pdfs = ImporterGroupSubjectFUN_XLS('BA', ba, 'WAITBAR', true).get('GET_DIR').get('GR'); % Load Group FUN from XLS % Group PDFs

%% Convert PDFs to Connectivity
cn = ConverterPDFs2CON('GR_PDFS', gr_pdfs, 'METHOD', 'correlation'); % Convert PDFs to CON using correlation % PDFs-to-CON Converter

%% Export Connectivity Data
ex_con = ExporterGroupSubjectCON_XLS('GR', cn.get('GR_CON'), 'WAITBAR', true); % Export Group CON to XLS % Export Group CON
ex_ba = ExporterBrainAtlasXLS('BA', ba, 'WAITBAR', true); % Export Brain Atlas to XLS % Export Brain Atlas
