# ============================================================
# macOS / system files
# ============================================================

.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride


# ============================================================
# MATLAB temporary / autosave / generated files
# ============================================================

*.asv
*.m~
*.mat
*.fig
*.mex*
*.mlappinstall
*.slxc

# MATLAB code analyzer / reports
mlint/
codegen/
mex/


# ============================================================
# BRAPH 2 generated / copied source tree
# ============================================================
# braph2genesis is copied/generated locally and should not be tracked.

braph2genesis/


# ============================================================
# Generated example neuroimaging data
# ============================================================
# Simulated NIfTI data can be regenerated by create_data_NIfTI_*.m scripts.

neuroimaging conversion structural/Example data NIfTI/
neuroimaging conversion PDFs/Example data NIfTI PDF shape covariation/

# In case generated copies appear under braph2individualconnectome
braph2individualconnectome/pipelines/neuroimaging conversion structural/Example data NIfTI/
braph2individualconnectome/pipelines/neuroimaging conversion PDFs/Example data NIfTI PDF shape covariation/


# ============================================================
# Converted output data
# ============================================================

neuroimaging conversion structural/Converted data*/
neuroimaging conversion PDFs/Converted data*/
braph2individualconnectome/pipelines/neuroimaging conversion structural/Converted data*/
braph2individualconnectome/pipelines/neuroimaging conversion PDFs/Converted data*/


# ============================================================
# Validation-generated data folders
# ============================================================

neuroimaging conversion structural/Example data NIfTI/validation_seed_*/
braph2individualconnectome/pipelines/neuroimaging conversion structural/Example data NIfTI/validation_seed_*/


# ============================================================
# Large generated neuroimaging files
# ============================================================
# Keep source/example atlas NIfTI files only if intentionally versioned.
# Generated subject-level NIfTI files should not be tracked.

**/sub-*/ses-*/anat/*.nii
**/sub-*/ses-*/pet/*.nii
**/sub-*/ses-*/anat/*.nii.gz
**/sub-*/ses-*/pet/*.nii.gz


# ============================================================
# Generated reference tables / PDF matrices
# ============================================================

**/reference_data/group_*.xlsx
**/reference_data/groundtruth_*.xlsx
**/reference_data/pdf_gmprob/*.xlsx
**/reference_data/pdf_wmprob/*.xlsx
**/reference_data/pdf_pet/*.xlsx


# ============================================================
# Optional local logs / scratch
# ============================================================

*.log
tmp/
temp/
scratch/